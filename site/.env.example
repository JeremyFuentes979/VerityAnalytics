# Copy to .env (never commit .env). Real environment variables override this file.

# Public URL of the site, used for Stripe redirect URLs. No trailing slash.
SITE_URL=http://localhost:3000

# Stripe (https://dashboard.stripe.com/apikeys). Use sk_test_... until you are ready to charge real cards.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint pointing at {SITE_URL}/api/stripe-webhook
# (event: checkout.session.completed). For local testing: `stripe listen --forward-to localhost:3000/api/stripe-webhook`
STRIPE_WEBHOOK_SECRET=

# LOCAL TESTING ONLY: skip Stripe and treat every checkout as paid.
# Ignored automatically when NODE_ENV=production.
VERITY_DEV_PAYMENT_BYPASS=0

# Optional overrides
# VERITY_PYTHON=/path/to/python           (default: ../.venv/bin/python, then python3)
# VERITY_SESSIONS_DIR=/path/to/sessions   (default: ../sessions)
# PORT=3000
# HOST=0.0.0.0
